# CloudQueryX AI Context Engine - Environment Configuration
# Copy this to .env and fill in your values

# ─── Supabase PostgreSQL ────────────────────────────────────────
# Get these from: https://supabase.com → Project Settings → Database
CLOUDQUERYX_DB_URL=jdbc:postgresql://db.xxxxx.supabase.co:5432/postgres
CLOUDQUERYX_DB_USER=postgres
CLOUDQUERYX_DB_PASSWORD=your-supabase-db-password

# ─── Server ─────────────────────────────────────────────────────
CLOUDQUERYX_PORT=8080
CLOUDQUERYX_HOST=0.0.0.0

# ─── Vector Dimensions ──────────────────────────────────────────
# Match your embedding model's output dimension
# OpenAI text-embedding-3-small = 1536
# OpenAI text-embedding-ada-002 = 1536
# Cohere embed-english-v3.0 = 1024
# all-MiniLM-L6-v2 = 384
CLOUDQUERYX_VECTOR_DIMENSION=384

# ─── Memory Decay ───────────────────────────────────────────────
# Lambda values for exponential decay: recency = e^(-lambda * hours)
CLOUDQUERYX_DECAY_WORKING=0.1
CLOUDQUERYX_DECAY_SEMANTIC=0.001
CLOUDQUERYX_DECAY_EPISODIC=0.005
CLOUDQUERYX_DECAY_PROCEDURAL=0.002

# ─── Connection Pool ────────────────────────────────────────────
CLOUDQUERYX_DB_POOL_SIZE=10
CLOUDQUERYX_DB_POOL_TIMEOUT=30000

# ─── JWT / Session ──────────────────────────────────────────────
CLOUDQUERYX_SESSION_TIMEOUT_HOURS=24

# Assistant demo LLM
# Used only by /api/assistant/chat. CloudQueryX still owns retrieval,
# memory, ranking, and context bundle construction.
OPENAI_API_KEY=sk-your-openai-key
CLOUDQUERYX_LLM_PROVIDER=openai
CLOUDQUERYX_LLM_MODEL=gpt-4.1-mini
CLOUDQUERYX_CHAT_TOKEN_BUDGET=8000
CLOUDQUERYX_LLM_TIMEOUT_SECONDS=45
